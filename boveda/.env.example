# ---- Claude (analisis y reempaquetado) ----
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto para analisis y repurpose
BOVEDA_MODEL=claude-opus-5

# ---- Rutas ----
# Carpeta raiz donde se guarda todo (db + media + audio + exports)
# Por defecto: <carpeta del proyecto>/data. Solo cambialo si quieres los datos en otro sitio.
# BOVEDA_HOME=/ruta/alternativa

# ---- Transcripcion ----
# local  -> usa faster-whisper en tu maquina (pip install "boveda[whisper]")
# cmd    -> usa un comando externo; ver BOVEDA_TRANSCRIBE_CMD
BOVEDA_TRANSCRIBE_ENGINE=local
BOVEDA_WHISPER_MODEL=medium
BOVEDA_WHISPER_DEVICE=auto
# Plantilla de comando; {audio} se reemplaza por la ruta del archivo.
# Debe escribir la transcripcion en stdout.
# BOVEDA_TRANSCRIBE_CMD=whisper-cli -f {audio} --output-txt -

# ---- Descarga ----
# Cookies exportadas del navegador (necesarias para guardados privados de IG/TikTok)
# BOVEDA_COOKIES_FILE=./cookies.txt
# BOVEDA_KEEP_VIDEO=0   # 1 = guarda tambien el mp4, no solo el audio

# ---- OCR de fotogramas (videos de puro texto, sin voz) ----
# claude    -> lee el texto en pantalla con vision (mejor con tipografia de redes)
# tesseract -> OCR local y gratis; requiere el binario tesseract instalado
BOVEDA_OCR_ENGINE=claude
# Maximo de fotogramas clave que se envian por video
BOVEDA_OCR_MAX_FRAMES=12
# Se hace OCR si la transcripcion tiene menos de N caracteres (0 = solo con --todos)
BOVEDA_OCR_UMBRAL=200
# Idiomas para tesseract (paquetes tesseract-ocr-spa / -eng)
BOVEDA_OCR_LANGS=spa+eng

# ---- Publicacion en redes ----
# Instagram y TikTok(PULL_FROM_URL) descargan el medio de una URL publica.
# Apunta esto a la carpeta donde sirves los videos ya montados.
# BOVEDA_MEDIA_BASE_URL=https://cdn.tudominio.com/boveda

# Instagram: cuenta profesional + pagina de Facebook + token de larga duracion
# con permiso instagram_business_content_publish
# IG_USER_ID=17841400000000000
# IG_ACCESS_TOKEN=EAA...
# BOVEDA_IG_API_VERSION=v21.0

# TikTok: token con scope video.publish.
# Hasta que TikTok audite tu app, la unica privacidad permitida es SELF_ONLY.
# TIKTOK_ACCESS_TOKEN=act...
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# YouTube: OAuth de aplicacion instalada (scope youtube.upload)
# YT_CLIENT_ID=...apps.googleusercontent.com
# YT_CLIENT_SECRET=...
# YT_REFRESH_TOKEN=1//...
# YT_PRIVACY=private        # private | unlisted | public
# YT_CATEGORY_ID=22

# X: token de usuario con permisos de escritura
# X_ACCESS_TOKEN=...

# ---- Montaje de video (voz + subtitulos) ----
# piper    -> voz local y gratis; BOVEDA_TTS_VOICE apunta al modelo .onnx
# cmd      -> cualquier TTS externo; ver BOVEDA_TTS_CMD. Debe escribir un WAV.
# ninguna  -> sin voz: solo rotulos y subtitulos con duracion estimada
BOVEDA_TTS_ENGINE=piper
# BOVEDA_TTS_VOICE=/ruta/es_ES-sharvard-medium.onnx
# BOVEDA_TTS_CMD=mi-tts --texto {texto} --salida {salida}
BOVEDA_RESOLUCION=1080x1920
BOVEDA_FUENTE=DejaVu Sans
