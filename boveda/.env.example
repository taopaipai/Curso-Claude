# ---- Claude (analisis y reempaquetado) ----
ANTHROPIC_API_KEY=sk-ant-...
# Modelo por defecto para analisis y repurpose
BOVEDA_MODEL=claude-opus-5

# ---- Rutas ----
# Carpeta raiz donde se guarda todo (db + media + audio + exports)
BOVEDA_HOME=./data

# ---- Transcripcion ----
# local  -> usa faster-whisper en tu maquina (pip install "boveda[whisper]")
# cmd    -> usa un comando externo; ver BOVEDA_TRANSCRIBE_CMD
BOVEDA_TRANSCRIBE_ENGINE=local
BOVEDA_WHISPER_MODEL=medium
BOVEDA_WHISPER_DEVICE=auto
# Plantilla de comando; {audio} se reemplaza por la ruta del archivo.
# Debe escribir la transcripcion en stdout.
# BOVEDA_TRANSCRIBE_CMD=whisper-cli -f {audio} --output-txt -

# ---- Descarga ----
# Cookies exportadas del navegador (necesarias para guardados privados de IG/TikTok)
# BOVEDA_COOKIES_FILE=./cookies.txt
# BOVEDA_KEEP_VIDEO=0   # 1 = guarda tambien el mp4, no solo el audio
